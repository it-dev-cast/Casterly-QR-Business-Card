# Copy to .env and adjust.

# Port and interface to listen on (0.0.0.0 lets phones on your Wi-Fi reach it).
PORT=4300
HOST=0.0.0.0

# Public address used in QR codes, e.g. https://cards.yourcompany.com
# Leave empty to use the address the admin page is opened on (or set it in the app's QR popup).
PUBLIC_URL=

# ---- Employee data: nexusAuth (Nexus core) is the only source ----
# CardDesk reads employees through nexusAuth's API with this service account. Use an account with
# the operator or admin role (admin sees every company). Never commit real credentials.
NEXUSAUTH_URL=http://127.0.0.1:8000
NEXUSAUTH_EMAIL=
NEXUSAUTH_PASSWORD=
# How long CardDesk reuses the employee list before asking nexusAuth again.
NEXUSAUTH_CACHE_SECONDS=30

# nexusAuth roles that may sign in to CardDesk (people sign in with their nexusAuth account).
ALLOWED_ROLES=admin,operator

# ---- CardDesk's own settings: a schema inside nexusAuth's database (no separate database) ----
# Created once by scripts/setup-database.sql. Holds card links (QR codes), card branding, uploaded
# banner/logo images and sign-in sessions. It has no employee data.
DATABASE_URL=postgresql://carddesk_app:choose-a-password@localhost:5432/nexus_auth
DATABASE_SCHEMA=carddesk
# Throwaway database for `npm run test:db` (wiped on every run). `npm test` needs no database.
TEST_DATABASE_URL=postgresql://carddesk_app:choose-a-password@localhost:5432/carddesk_test

# Set to true when running behind a reverse proxy that terminates HTTPS (enables Secure cookies).
TRUST_PROXY=false

SESSION_HOURS=12
LOG_REQUESTS=true
